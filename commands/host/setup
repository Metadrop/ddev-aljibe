#!/bin/bash
#ddev-generated
## Description: Configure environment and optionally install sites
## Usage: setup [flags]
## Flags: [{"Name":"all","Shorthand":"a","Usage":"Install all sites"},{"Name":"no-install","Shorthand":"n","Usage":"Do not install sites"},{"Name":"no-themes","Shorthand":"f","Usage":"Do not process themes"},{"Name":"sites","Shorthand":"s","Usage":"Install specific sites (comma-separated)"},{"Name":"themes","Shorthand":"t","Usage":"Only process specified themes (comma-separated)"},{"Name":"parallel","Shorthand":"p","Usage":"Install sites in parallel, optionally in batches of N (e.g. --parallel=3)"}]
## Example: ddev setup --no-install

set -e

# Include the ddev_checks script
# shellcheck source=includes/aljibe_includes
source "$(dirname "$0")/includes/aljibe_includes"

# Initialize our own variables
NO_INSTALL=0
NO_THEMES=0
INSTALL_ALL=0
PARALLEL=0
PARALLEL_BATCH_SIZE=0

## Project must be running to run this command
star_project

CONFIG_DEFAULT_SITE=$(ddev aljibe-config default_site)
# aljibe-config returns "" for missing keys; keep 'null' for safety.
if [ -z "$CONFIG_DEFAULT_SITE" ] || [ "$CONFIG_DEFAULT_SITE" == 'null' ]; then
  SITES=('self')
else
  SITES=("$CONFIG_DEFAULT_SITE")
fi

THEMES=()

# A POSIX variable
OPTIND=1         # Reset in case getopts has been used previously in the shell.

help() {
echo "Usage: ddev setup [options]"
  echo
  echo "Options:"
  echo "  -h, --help        Show this help message and exit"
  echo "  -a, --all         Install all sites"
  echo "  -f, --no-themes   Do not process themes"
  echo "  -n, --no-install  Do not install sites"
  echo "  -s, --sites       Install specific sites"
  echo "  -t, --themes      Only process specified themes"
  echo "  -p, --parallel    Install sites in parallel (optionally in batches of N)"
  echo
  echo "Examples:"
  echo "  ddev setup -a          Install all sites"
  echo "  ddev setup -n -f          Do not install sites and do not process themes"
  echo "  ddev setup -s=site1,site2 Install specific sites (site1 and site2)"
  echo "  ddev setup -t=theme1      Only process specified theme (theme1)"
  echo "  ddev setup -a -p          Install all sites in parallel, all at once"
  echo "  ddev setup -a -p=3        Install all sites in parallel, in batches of 3"
  exit 0
}

handle_options() {
  while [ $# -gt 0 ]; do
    case $1 in
      -a | --all)
        INSTALL_ALL=1
        shift
        ;;
      -h | --help)
        help
        ;;
      -n | --no-install)
        NO_INSTALL=1
        shift
        ;;
      -f | --no-themes)
        NO_THEMES=1
        shift
        ;;
      -s* | --sites*)
        if [[ $1 == *=* ]]; then
          IFS=',' read -r -a SITES <<< "$(extract_argument "$1")"
          shift
        else
          if [ -z "$2" ]; then
            echo "Sites not specified." >&2
            exit 1
          fi
          IFS=',' read -r -a SITES <<< "$2"
          shift 2
        fi
        ;;
      -t* | --themes*)
        if [[ $1 == *=* ]]; then
          IFS=',' read -r -a THEMES <<< "$(extract_argument "$1")"
          shift
        else
          if [ -z "$2" ]; then
            echo "Themes not specified." >&2
            exit 1
          fi
          IFS=',' read -r -a THEMES <<< "$2"
          shift 2
        fi
        ;;
      -p* | --parallel*)
        PARALLEL=1
        if [[ $1 == *=* ]]; then
          PARALLEL_BATCH_SIZE="$(extract_argument "$1")"
          shift
        elif [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
          PARALLEL_BATCH_SIZE="$2"
          shift 2
        else
          PARALLEL_BATCH_SIZE=0
          shift
        fi
        if ! [[ "$PARALLEL_BATCH_SIZE" =~ ^[0-9]+$ ]]; then
          echo "Invalid value for --parallel: '${PARALLEL_BATCH_SIZE}'. It must be a number." >&2
          exit 1
        fi
        ;;
      *)
        echo "Invalid option: $1" >&2
        exit 1
        ;;
    esac
  done
}

# Main script execution
handle_options "$@"

# Launch pre setup hooks
run_hooks "pre_setup"

# Prepare Drupal and dev environment
ddev composer install || exit 1

# Set up GrumPHP git hooks, only in a git repository. Outside one, GrumPHP's
# Composer plugin may already have run git:init during composer install,
# creating a stray .git/hooks folder: remove it (and .git, if then empty).
PROJECT_ROOT="${DDEV_APPROOT:-.}"
if git -C "${PROJECT_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  ddev exec vendor/bin/grumphp git:init
else
  echo "Not a git repository, skipping GrumPHP git hooks setup."
  if [ -d "${PROJECT_ROOT}/.git/hooks" ]; then
    rm -rf "${PROJECT_ROOT}/.git/hooks"
    rmdir "${PROJECT_ROOT}/.git" 2>/dev/null || true
  fi
fi

# Building frontend theme
if [ "$NO_THEMES" -eq 0 ]; then
  echo
  echo -e "\033[32mBuilding frontend themes: \033[0m\n"
  if [ ${#THEMES[@]} -eq 0 ]; then
    THEMES=()
    while IFS= read -r line; do
      THEMES+=("$line")
    done < <(ddev aljibe-config theme_paths --keys)
  fi
  if [ ${#THEMES[@]} -eq 0 ]; then
    echo "No themes found, any theme will be processed. If there should be any theme processed, please add them to aljibe.yml"
  elif [ ${#THEMES[@]} -eq 1 ]; then
    ddev frontend production "${THEMES[0]}"
  else
    for theme in "${THEMES[@]}"; do
      echo -e "\033[32mBuilding theme:\033[32;1m ${theme}\033[0m"
      ddev frontend production "$theme"
    done
  fi
fi

# Try to install sites if not --no-install is given
if [ "$NO_INSTALL" -eq 0 ]; then
    if [ "$INSTALL_ALL" -eq 1 ]; then
        read -r -a SITES <<< "$(get_all_installable_sites)"
    fi
    if [ "$PARALLEL" -eq 1 ]; then
        install_sites_parallel "$PARALLEL_BATCH_SIZE" "${SITES[@]}"
    else
        for SITE in "${SITES[@]}"; do
            echo
            echo -e "\033[32mInstalling site: ${SITE}  \033[0m\n"
            ddev site-install "$SITE"
        done
    fi
fi

# Launch post setup hooks
run_hooks "post_setup"

