#!/bin/bash
#ddev-generated
## Description: Launches a drush command on all of the sites
## Usage: all-sites-drush [drush command]

# shellcheck source=includes/aljibe_includes
source "$(dirname "$0")/includes/aljibe_includes"

ENV='local'
SITES=()

if [ $# -eq 0 ]; then
  echo "Please provide a drush command" >&2
  exit 1
fi

## Get all sites from the drush/sites folder.
set_sites_variable

## Run the command in all sites.
for SITE in "${SITES[@]}"; do
  SITE_ALIAS=$SITE.$ENV
  echo "Running drush $* in $SITE"
  # "$@" keeps each drush argument intact, e.g. sqlq "SELECT 1".
  ddev drush "@${SITE_ALIAS}" "$@"
done
